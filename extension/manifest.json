{
  "manifest_version": 3,
  "name": "Autogram — Apply from Job Link",
  "version": "0.2.0",
  "description": "Fills job applications in your own logged-in Chrome tab using your Autogram profile. Auto-submit only fires when the server's own decide_action() approves it; CAPTCHA and low-confidence review always stay in your hands. Never runs in Incognito.",
  "key": "",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Autogram — open the side panel"
  },
  "side_panel": {
    "default_path": "dist/sidepanel/index.html"
  }
}
