# Local development: leave blank to use Vite's /api proxy.
VITE_API_URL=

# Vite dev-proxy target. This is not included in the browser bundle.
VITE_API_TARGET=http://127.0.0.1:8000

# Production setting (baked into the bundle at build time, must not end with "/").
# Set this on the Railway "frontend" service — see RAILWAY.md:
#   VITE_API_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}
