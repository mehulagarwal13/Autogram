# Environment variables
.env

# Extension dev signing key (controls the stable chrome-extension:// ID) + build output/deps
extension/dev-key.pem
extension/dist/
extension/node_modules/

# Python virtual environment
venv/

# Python cache
__pycache__/
*.pyc

# VS Code settings (optional)
.vscode/

# OS files
.DS_Store
Thumbs.db

# Browser profiles for AUTOMATION_BROWSER_MODE=cdp/persistent (see
# automation/browser/chrome_attach.py) — hundreds of MB of Chrome's own binary
# state, and it holds the user's live login cookies. Never commit it.
storage/chrome_profile/

# Playwright artifacts
trace.zip
*.trace
screenshot*.png
test-results/
playwright-report/

# Root-level Remotion demo-video project (src/, remotion.config.ts, tsconfig.json)
node_modules/
package-lock.json
out/
.remotion/
