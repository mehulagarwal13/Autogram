# Required backend runtime configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
OPENAI_API_KEY=replace-me
ADZUNA_APP_ID=replace-me
ADZUNA_APP_KEY=replace-me
JWT_SECRET=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-a-fernet-key

# Browser/API origins. Local Vite development uses a proxy and needs neither.
# Production example: https://app.example.com
CORS_ORIGINS=
# Optional Pages preview origins. Escape literal dots in the regex.
# Example: ^https://([a-z0-9-]+\.)?autogram\.pages\.dev$
CORS_ORIGIN_REGEX=

# Optional security/runtime settings
# API_KEY=replace-with-a-long-random-value
# JWT_EXPIRE_MINUTES=1440
# RATE_LIMIT_PER_MINUTE=60
# AUTOMATION_BROWSER_MODE=cdp
# AUTOMATION_HEADLESS=true
# AUTOMATION_CDP_URL=http://127.0.0.1:9222
# AUTOMATION_CDP_AUTOLAUNCH=true
# AUTOMATION_CDP_LAUNCH_TIMEOUT_S=30
# AUTOMATION_CHROME_PATH=
# AUTOMATION_CHROME_USER_DATA_DIR=storage/chrome_profile
# AUTOMATION_SESSION_DIR=storage/automation_sessions
# AUTOMATION_LOGS_DIR=logs
# AUTOMATION_HUMAN_WAIT_TIMEOUT_S=600
# AUTOMATION_VISION_FALLBACK=true
# AUTOGRAM_HUMAN_PACING=1
# RETENTION_PURGE_INTERVAL_HOURS=24

# Optional scheduled job ingestion
# JOB_SYNC_QUERIES=backend engineer;python developer
# JOB_SYNC_INTERVAL_HOURS=6
# JOB_SYNC_COUNTRY=gb

# Optional S3-compatible object storage (Cloudflare R2 uses these too)
# STORAGE_BACKEND=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
