OPENAI_API_KEY=your-openapi-key-here
ADZUNA_APP_ID=adzuna_app_id
ADZUNA_APP_KEY=adzuna_app_key
# Neon Cloud connection string — get it from https://neon.tech (project dashboard -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-endpoint.region.aws.neon.tech/neondb?sslmode=require
# Vector search runs on Neon via pgvector — no separate vector DB keys required.

# JWT signing secret for user auth — set a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRE_MINUTES=1440

# Field-level encryption key for candidate profile PII (phone, address).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- Optional: automatic background job sync (leave unset to disable) ---
# JOB_SYNC_QUERIES=backend engineer;python developer
# JOB_SYNC_INTERVAL_HOURS=6
# JOB_SYNC_COUNTRY=gb

# --- Optional: production hardening ---
# API_KEY=generate-a-long-random-string     # enables X-API-Key auth on all endpoints
# RATE_LIMIT_PER_MINUTE=60                  # per-IP request cap (default 60)
# CORS_ORIGINS=https://your-frontend.com    # comma-separated allowed origins

# --- Optional: automation / browser engine (Phase 2+, automation/browser/*) ---
# How we get a browser. Default "cdp": attach to your ALREADY-RUNNING Chrome over the
# DevTools Protocol and open each job in a NEW TAB, reusing your real profile (cookies,
# Gmail/LinkedIn/Workday logins). "persistent": our own normal, non-incognito window on a
# reusable profile directory. "launch": throwaway browser + empty context (CI/servers).
# AUTOMATION_BROWSER_MODE=cdp
# AUTOMATION_CDP_URL=http://127.0.0.1:9222           # where Chrome's remote debugging listens
# AUTOMATION_CDP_AUTOLAUNCH=true                     # false = never start Chrome ourselves
# AUTOMATION_CDP_LAUNCH_TIMEOUT_S=30                 # wait for a Chrome we started to open the port
# AUTOMATION_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe   # unset = auto-detect
# Profile dir for a browser WE start (a per-user subdirectory is created under it).
# Set to "chrome-default" to use your real Chrome profile — only works with Chrome fully closed.
# AUTOMATION_CHROME_USER_DATA_DIR=storage/chrome_profile
# AUTOMATION_HEADLESS=true                          # only used by AUTOMATION_BROWSER_MODE=launch
# AUTOMATION_SESSION_DIR=storage/automation_sessions # encrypted per-user/per-ATS Playwright sessions
# AUTOMATION_LOGS_DIR=logs                           # screenshots/traces/error logs per application run

# --- Optional: object storage (default: local disk under storage/) ---
# See app/services/storage/s3_backend.py before enabling — read-path caveat
# for text extraction / automation resume upload, tracked in PHASE2_ARCHITECTURE.md.
# STORAGE_BACKEND=s3                # "local" (default) or "s3"
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=                  # set for Cloudflare R2 / MinIO; leave unset for AWS S3
# --- Optional: live chat event stream (app/services/event_bus.py) ---
# The WebSocket at /chat/{scope}/{id}/stream needs no configuration: events are
# fanned out IN-PROCESS, which is correct for the single-worker deployment this
# project targets (see the CMD comment in Dockerfile). There is deliberately no
# REDIS_URL here — adding a broker would be infrastructure the pause/resume
# design cannot yet use, since a paused task's browser handle also lives in one
# process's memory.
#
# Note for reverse proxies in front of Autogram: the stream authenticates with
# the JWT as a QUERY PARAMETER, because the browser WebSocket API cannot set an
# Authorization header. Autogram's own request logging never records query
# strings, but many proxies do by default — turn that off, or the token lands in
# access logs.
